# ============================================================
#  影画工坊 / Yinghua Workshop — server environment
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
#  Server-side keys: the frontend never sees these.
# ============================================================

# Port for the Node proxy (default 8787)
PORT=8787

# Allowed browser origin for CORS (the Vite dev server in development)
CORS_ORIGIN=http://localhost:5173

# --- Frontend: backend origin when frontend is deployed separately ---
# When the frontend is hosted on Vercel (static) and the Express proxy
# lives on Railway / another host, set this to the backend root URL
# so relative /api/* calls resolve correctly.
# Leave empty for dev (Vite proxies /api → localhost:8787).
VITE_API_BASE_URL=https://your-backend.up.railway.app

# --- Alipay website sponsorship (server-side only) ---
# PC and mobile browser pages both use alipay.trade.page.pay.
ALIPAY_APP_ID=
# Node.js alipay-sdk expects the original PKCS#1 private key value without PEM wrappers.
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Sandbox by default; switch explicitly to production only after launch checks.
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
# Leave notify URL empty for local acceptance; production must use public HTTPS.
ALIPAY_NOTIFY_URL=
# Must point to the real GET route in this app when configured.
ALIPAY_RETURN_URL=
# Server-side Supabase credentials; never expose the service role key to Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provider: seedream (image-to-image / image edit) ---
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://api.seedream.example/v1

# --- Provider: gpt-image (OpenAI gpt-image-1) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vision model (face detection for viewer clip regions; gpt-4o-mini) ---
# Separate from the gpt-image key on purpose — no fallback between them.
# If empty and the frontend sends no key, /api/detect-face returns 401.
VISION_API_KEY=

# Outbound request timeout in ms (default 300000 — image-to-image can take minutes)
UPSTREAM_TIMEOUT_MS=300000

# --- Security: rate limiting & usage caps ---
# Requests per window per visitor/IP across generate / inpaint / detect-face /
# payments / gallery endpoints.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Daily cap on server-preset (freeload) calls that spend the operator's paid
# keys. Set to 0 to disable server-preset usage entirely.
PRESET_DAILY_CAP=200
# Public backend origin used to build the Alipay payment return URL — never
# derive it from the Host header (host-header injection).
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# --- WeChat Pay (mini program sponsorship, JSAPI, server-side only) ---
# Requires an enterprise/个体户-verified mini program + WeChat Pay merchant account.
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_MCHID=
# APIv3 key: the 32-byte string set in the WeChat Pay merchant platform.
WECHAT_API_V3_KEY=
# Merchant API certificate serial number (from the merchant platform → 账户中心 → API安全).
WECHAT_MERCHANT_SERIAL_NO=
# Merchant APIv3 private key (PKCS8 PEM). Store as a single line: use `\n` escapes
# (e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----) or base64.
WECHAT_MERCHANT_PRIVATE_KEY=
# WeChat Pay platform public key (preferred, avoids certificate rotation) or the
# platform certificate public key. Same single-line `\n`-escaped PEM format.
WECHAT_PLATFORM_PUBLIC_KEY=
# Optional: platform public key serial to cross-check the Wechatpay-Serial header.
WECHAT_PLATFORM_PUBLIC_KEY_SERIAL=
# Public HTTPS notify URL. Production must point to the ICP-registered domain.
WECHAT_NOTIFY_URL=
