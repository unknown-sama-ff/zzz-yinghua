.slot-row {
  display: flex;
  gap: 20rpx;
}

.slot {
  flex: 1;
  height: 200rpx;
  border: 1rpx dashed rgba(245, 240, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a9a;
  font-size: 24rpx;
  overflow: hidden;
  background: rgba(245, 240, 255, 0.03);
}

.slot image {
  width: 100%;
  height: 100%;
}

.result-row {
  margin-top: 20rpx;
}

.result-img {
  width: 100%;
  border-radius: 16rpx;
}

.style-card {
  border: 1rpx solid rgba(245, 240, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(245, 240, 255, 0.03);
}

.style-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.style-label {
  font-size: 30rpx;
  font-weight: 600;
}

.style-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.status-done { color: #7dd87d; background: rgba(125, 216, 125, 0.12); }
.status-running { color: #ffd166; background: rgba(255, 209, 102, 0.12); }
.status-error { color: #ff2d9b; background: rgba(255, 45, 155, 0.12); }
.status-idle { color: #8a8a9a; background: rgba(138, 138, 154, 0.12); }

.style-desc {
  font-size: 24rpx;
  color: #8a8a9a;
  margin: 12rpx 0;
}

.style-img {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
