.center-hint {
  color: #8a8a9a;
  font-size: 26rpx;
  padding: 60rpx 0;
  text-align: center;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cell {
  position: relative;
  width: calc((100% - 20rpx) / 2);
  height: 0;
  padding-top: calc((100% - 20rpx) / 2);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(245, 240, 255, 0.1);
  background: rgba(245, 240, 255, 0.03);
}

.cell-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cell-loading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a9a;
  font-size: 22rpx;
}

.cell-style {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #f5f0ff;
  font-size: 20rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
