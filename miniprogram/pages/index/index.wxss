.section-label {
  font-size: 24rpx;
  color: #8a8a9a;
  margin: 28rpx 0 12rpx;
}

.upload-box {
  width: 100%;
  height: 420rpx;
  border: 1rpx dashed rgba(245, 240, 255, 0.25);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(245, 240, 255, 0.03);
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8a8a9a;
  font-size: 26rpx;
  gap: 8rpx;
}

.upload-plus {
  font-size: 64rpx;
  color: #b026ff;
}

.placeholder {
  color: #5a5a6a;
}

.provider-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.provider-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}
