{
  "name": "yinghua-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "绝区零「影画工坊」— upload a character image, generate three-views + ZZZ yinghua action art, and explore it in a faithful ZZZ-style layered viewer.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"npm:dev:server\"",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test \"server/**/*.test.js\" \"tests/frontend/*.test.js\"",
    "lint": "tsc --noEmit && tsc --noEmit -p tests/browser/tsconfig.json",
    "test:frontend": "node --test \"tests/frontend/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "alipay-sdk": "^4.14.0",
    "body-parser": "^1.20.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.5.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "body-parser": "$body-parser",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "urllib": "4.9.1",
    "undici": "$undici",
    "postcss": "$postcss",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.28.7",
    "nanoid": "3.3.18",
    "postcss-selector-parser": "6.1.5",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  }
}
